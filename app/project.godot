; GameCove — Godot 4 project settings.
; Compatibility renderer and low-processor mode keep idle power down on handhelds.

config_version=5

[application]

config/name="GameCove"
config/description="The all-in-one companion for Linux handhelds."
config/icon="res://icon.svg"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true

[audio]

driver/driver="Dummy"

[autoload]

Device="*res://scripts/device/device.gd"
Power="*res://scripts/device/power.gd"
DevicePhoto="*res://scripts/device/photo.gd"
Library="*res://scripts/library/library.gd"
Launcher="*res://scripts/launch/launcher.gd"
Gamescope="*res://scripts/gamescope/gamescope.gd"
Discover="*res://scripts/discover/discover.gd"
Art="*res://scripts/discover/art.gd"
PerfMonitor="*res://scripts/perf/perf_monitor.gd"
Achievements="*res://scripts/achievements/achievements.gd"
Updates="*res://scripts/system/updates.gd"
Storage="*res://scripts/system/storage.gd"
Setup="*res://scripts/system/setup.gd"
Controller="*res://scripts/input/controller.gd"
Controls="*res://scripts/controls/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.039, 0.067, 0.125, 1)
