# Godot
app/.godot/
*.import
# Bundled device pictures must ship as raw files (importer "keep"), so their .import is tracked.
!app/assets/device_photos/*.import

# Python
__pycache__/
*.egg-info/
.pytest_cache/
gamedb/dist/
.venv/

# Export output (app/export_presets.cfg)
app/build/

# raw-read assets keep their tracked .import (importer="keep"); see packaging/tests/run.sh
!app/assets/brand/*.svg.import
!app/assets/device_photos/*.import

# Showcase art cache (tools/showcase/shoot.sh downloads it)
tools/showcase/cache/
