#!/bin/bash
# shellcheck disable=SC2034  # variables are read by gamescope-session-plus
# GameCove session for gamescope-session-plus (OpenGamingCollective/ChimeraOS).
# Installed to /usr/share/gamescope-session-plus/sessions.d/gamecove and started by
#   gamescope-session-plus gamecove
# from /usr/share/wayland-sessions/gamecove.desktop.
#
# gamescope-session-plus sources this file with `set -a`, so every variable here
# is exported to gamescope and to our client. Users can override any of them in
# ~/.config/environment.d/*.conf (sourced after this file), for example:
#   GAMECOVE_STEAM_MODE=off
#   CUSTOM_REFRESH_RATES=40,45,50,55,60,120   (enables Gamescope.set_refresh_rate)

# Main client: GameCove itself. It starts Steam in the background, then runs the
# Godot app, which marks its window as gamescope's main app (STEAM_GAME=769).
CLIENTCMD="/usr/libexec/gamecove/gamecove-session-client"

# How Steam runs beside us: silent (default), gamepadui (experimental) or off.
# See docs/SESSION.md.
: "${GAMECOVE_STEAM_MODE:=silent}"

# Steam's own cursor if Steam is installed; gamescope hides it after a few seconds.
CURSOR_FILE="${HOME}/.local/share/Steam/tenfoot/resource/images/cursors/arrow.png"

# If GameCove keeps failing to start (5 short sessions in a row), fall back to
# the distro's Steam Gaming Mode instead of looping on a black screen.
short_session_recover() {
	if command -v steamosctl >/dev/null 2>&1; then
		steamosctl switch-to-game-mode
	fi
}

# InputPlumber: GameCove sets InterceptMode 2 (everything to GameCove) while its
# UI has focus. If GameCove died or the session is switching, put every device
# back to 0 so Steam's session or the desktop get a normal controller.
reset_input_intercept() {
	command -v busctl >/dev/null 2>&1 || return 0
	local dev
	for dev in $(busctl --system --list tree org.shadowblip.InputPlumber 2>/dev/null |
		grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$'); do
		busctl --system --timeout=2 set-property org.shadowblip.InputPlumber "$dev" \
			org.shadowblip.Input.CompositeDevice InterceptMode u 0 >/dev/null 2>&1 || true
	done
}

# AYANEO charge limit (charge_behaviour): GameCove holds charging only while it
# runs. Let the battery charge again (the limit is kept for next time); polkit
# allows this one set without a password. The fix's udev rule is the backstop.
release_charge_limit() {
	local state="${GAMECOVE_STATE_DIR:-/var/lib/gamecove}" helper="${GAMECOVE_FIX_SET:-/usr/libexec/gamecove/gamecove-fix-set}"
	[ -f "$state/fixes/charge-limit/limit" ] || return 0
	[ -x "$helper" ] || return 0
	command -v pkexec >/dev/null 2>&1 || return 0
	timeout 15 pkexec "$helper" charge-limit set release >/dev/null 2>&1 || true
}

# CPU / GPU / platform values GameCove's power-tune verbs changed (and thermald, held while
# GameCove sets the TDP on Intel) back to what they were, so Steam's session or the desktop
# get the system as they left it. Same no-password entry point.
restore_power_tune() {
	local state="${GAMECOVE_STATE_DIR:-/var/lib/gamecove}" helper="${GAMECOVE_FIX_SET:-/usr/libexec/gamecove/gamecove-fix-set}"
	[ -d "$state/fixes/power-tune/orig" ] || [ -f "$state/fixes/power-tune/thermald-held" ] || return 0
	[ -x "$helper" ] || return 0
	command -v pkexec >/dev/null 2>&1 || return 0
	timeout 15 pkexec "$helper" power-tune set restore >/dev/null 2>&1 || true
}

# When GameCove exits: controller and battery back to normal, then close Steam
# cleanly so the session can end.
post_client_shutdown() {
	reset_input_intercept
	release_charge_limit
	restore_power_tune
	if command -v steam >/dev/null 2>&1 && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
		steam -shutdown >/dev/null 2>&1 || true
	fi
}
