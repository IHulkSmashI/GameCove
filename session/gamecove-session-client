#!/bin/sh
# GameCove session client: the CLIENTCMD of the gamecove gamescope-session-plus
# session. Installed to /usr/libexec/gamecove/gamecove-session-client.
#
# 1. Starts Steam in the background (unless GAMECOVE_STEAM_MODE=off) so
#    steam://rungameid/ launches are instant and Steam Input is live.
# 2. Runs the GameCove Godot app on gamescope's X display, and when it exits
#    (even by a crash) puts InputPlumber's InterceptMode back to 0.
#
# Settings (environment, e.g. ~/.config/environment.d/gamecove.conf):
#   GAMECOVE_STEAM_MODE  silent (default) | gamepadui (experimental) | off
#   GAMECOVE_BIN         path of the GameCove binary
set -u

GAMECOVE_BIN="${GAMECOVE_BIN:-/usr/lib/gamecove/gamecove.x86_64}"
GAMECOVE_STEAM_MODE="${GAMECOVE_STEAM_MODE:-silent}"

log() {
	echo "gamecove-session-client: $*" >&2
}

steam_running() {
	pgrep -u "$(id -u)" -x steam >/dev/null 2>&1
}

start_steam() {
	if ! command -v steam >/dev/null 2>&1; then
		log "Steam is not installed; Steam games won't launch"
		return 0
	fi
	if steam_running; then
		return 0
	fi
	case "$GAMECOVE_STEAM_MODE" in
	silent)
		# Normal Steam client, no window: games, overlay and Steam Input work,
		# the UI stays hidden. UNTESTED on hardware, see docs/SESSION.md.
		steam -silent >/dev/null 2>&1 &
		;;
	gamepadui)
		# Steam's handheld UI, hidden. Same flags OpenGamepadUI's Steam plugin
		# uses. Gives Steam's on-screen keyboard and quick menu, but Steam may
		# try to take the main-app role from us. EXPERIMENTAL.
		steam -silent -gamepadui -steamos3 -steampal -steamdeck >/dev/null 2>&1 &
		;;
	off)
		;;
	*)
		log "unknown GAMECOVE_STEAM_MODE '$GAMECOVE_STEAM_MODE', not starting Steam"
		;;
	esac
}

start_steam

if [ ! -x "$GAMECOVE_BIN" ]; then
	log "GameCove binary not found at $GAMECOVE_BIN"
	exit 1
fi

# InputPlumber: put every device back to InterceptMode 0 (GameCove sets 2 while
# its UI has focus; after a crash nobody would be listening).
reset_input_intercept() {
	command -v busctl >/dev/null 2>&1 || return 0
	for dev in $(busctl --system --list tree org.shadowblip.InputPlumber 2>/dev/null |
		grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$'); do
		busctl --system --timeout=2 set-property org.shadowblip.InputPlumber "$dev" \
			org.shadowblip.Input.CompositeDevice InterceptMode u 0 >/dev/null 2>&1 || true
	done
}

# X11 on purpose: gamescope reads focus and overlay properties from X windows.
# Not exec'd: when the app exits (or crashes) we still hand the controller back.
"$GAMECOVE_BIN" --display-driver x11 --rendering-driver opengl3 --fullscreen "$@" &
app=$!
trap 'kill -TERM "$app" 2>/dev/null' TERM INT HUP
code=0
wait "$app" || code=$?
# a signal interrupts wait before the app is gone: wait for the real exit
while kill -0 "$app" 2>/dev/null; do
	code=0
	wait "$app" || code=$?
done
reset_input_intercept
exit "$code"
