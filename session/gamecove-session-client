#!/bin/sh
# GameCove session client: the CLIENTCMD of the gamecove gamescope-session-plus
# session. Installed to /usr/libexec/gamecove/gamecove-session-client.
#
# 1. Starts Steam in the background (unless GAMECOVE_STEAM_MODE=off) so
#    steam://rungameid/ launches are instant and Steam Input is live.
# 2. Runs the GameCove Godot app on gamescope's X display, and when it exits
#    (even by a crash) puts InputPlumber's InterceptMode back to 0.
#
# Settings (environment, e.g. ~/.config/environment.d/gamecove.conf):
#   GAMECOVE_STEAM_MODE  silent (default) | gamepadui (experimental) | off
#   GAMECOVE_BIN         path of the GameCove binary
#
# 3. Crash-loop guard: after 3 unclean exits in a row (a crash, a missing
#    binary; counted across sessions in ~/.local/share/gamecove/crash-count,
#    however long each run lasted), it gives up on GameCove for this boot and
#    switches to Steam Gaming Mode (or the desktop when Steam isn't installed),
#    so a broken update never traps the device. A clean exit, or a run that
#    stays up GAMECOVE_HEALTHY_S (10 min), clears the count. If the count can't
#    be saved (full or read-only home), it switches away at once. The reason is
#    left in crash-fallback; GameCove shows it at its next start.
# 4. Hang check (review H1): a GameCove that never gets going (no first heartbeat,
#    or no ready file when no heartbeat is expected, after GAMECOVE_READY_TIMEOUT_S,
#    60 s), or whose heartbeat file
#    ($XDG_RUNTIME_DIR/gamecove-heartbeat, rewritten every 5 s from the app's main
#    loop) stops changing for GAMECOVE_HEARTBEAT_STALE_S (30 s) while it says "ui",
#    is killed and counted as an unclean exit. While a game runs the app says
#    "game" and is never killed: ending GameCove would end the game too.
set -u

GAMECOVE_BIN="${GAMECOVE_BIN:-/usr/lib/gamecove/gamecove.x86_64}"
GAMECOVE_STEAM_MODE="${GAMECOVE_STEAM_MODE:-silent}"
SESSION_SELECT="${GAMECOVE_SESSION_SELECT:-/usr/bin/gamecove-session-select}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/gamecove"
CRASHES="$DATA/crash-count"
CRASH_LIMIT="${GAMECOVE_CRASH_LIMIT:-3}"
HEALTHY_S="${GAMECOVE_HEALTHY_S:-600}"
READY_TIMEOUT_S="${GAMECOVE_READY_TIMEOUT_S:-60}"
HEARTBEAT_STALE_S="${GAMECOVE_HEARTBEAT_STALE_S:-30}"

log() {
	echo "gamecove-session-client: $*" >&2
}

steam_running() {
	pgrep -u "$(id -u)" -x steam >/dev/null 2>&1
}

start_steam() {
	if ! command -v steam >/dev/null 2>&1; then
		log "Steam is not installed; Steam games won't launch"
		return 0
	fi
	if steam_running; then
		return 0
	fi
	case "$GAMECOVE_STEAM_MODE" in
	silent)
		# Normal Steam client, no window: games, overlay and Steam Input work,
		# the UI stays hidden. UNTESTED on hardware, see docs/SESSION.md.
		steam -silent >/dev/null 2>&1 &
		;;
	gamepadui)
		# Steam's handheld UI, hidden. Same flags OpenGamepadUI's Steam plugin
		# uses. Gives Steam's on-screen keyboard and quick menu, but Steam may
		# try to take the main-app role from us. EXPERIMENTAL.
		steam -silent -gamepadui -steamos3 -steampal -steamdeck >/dev/null 2>&1 &
		;;
	off)
		;;
	*)
		log "unknown GAMECOVE_STEAM_MODE '$GAMECOVE_STEAM_MODE', not starting Steam"
		;;
	esac
}

# A "switch to desktop" that didn't name a session (Steam's, after the user left
# GameCove for Steam) lands here because GameCove is the default desktop
# session: forward it to the real desktop before anything starts.
if [ -x "$SESSION_SELECT" ]; then
	"$SESSION_SELECT" session-start
	if [ $? -eq 3 ]; then
		log "forwarded a desktop switch to the real desktop"
		exit 0
	fi
fi

# Crash-loop guard. A crash is an exit we didn't cause (a session switch or
# logout sends us TERM: that's not a crash). Counts unclean exits in a row,
# whatever the uptime; at the limit, leave GameCove for this boot.
crash_count() {
	n="$(head -n 1 "$CRASHES" 2>/dev/null | tr -cd '0-9')"
	echo "${n:-0}"
}

fall_back() { # <reason: crashes | unsaved | missing | hung>
	rm -f "$CRASHES" "$DATA/crash-starts" 2>/dev/null
	printf '%s\n%s\n' "$(date +%s)" "$1" >"$DATA/crash-fallback" 2>/dev/null || true
	log "GameCove failed ($1); switching away so the device stays usable"
	[ -x "$SESSION_SELECT" ] || return 0
	if command -v steam >/dev/null 2>&1; then
		"$SESSION_SELECT" steam || "$SESSION_SELECT" desktop || true
	else
		"$SESSION_SELECT" desktop || true
	fi
}

record_crash() { # [reason]
	n=$(($(crash_count) + 1))
	if ! { mkdir -p "$DATA" && printf '%s\n' "$n" >"$CRASHES.tmp" && mv -f "$CRASHES.tmp" "$CRASHES"; } 2>/dev/null ||
		[ "$(crash_count)" != "$n" ]; then
		# a count we can't keep would never reach the limit: don't loop on it
		log "can't save the crash count in $CRASHES"
		fall_back unsaved
		return 0
	fi
	log "unclean exit $n of $CRASH_LIMIT${1:+ ($1)}"
	[ "$n" -ge "$CRASH_LIMIT" ] || return 0
	if [ "${1:-}" = "" ]; then fall_back crashes; else fall_back "$1"; fi
}

clear_crashes() {
	rm -f "$CRASHES" "$DATA/crash-starts" 2>/dev/null || true
}

if [ ! -x "$GAMECOVE_BIN" ]; then
	log "GameCove binary not found at $GAMECOVE_BIN"
	record_crash missing
	start_steam
	exit 1
fi

# InputPlumber: put every device back to InterceptMode 0 (GameCove sets 2 while
# its UI has focus; after a crash nobody would be listening).
reset_input_intercept() {
	command -v busctl >/dev/null 2>&1 || return 0
	for dev in $(busctl --system --timeout=2 --list tree org.shadowblip.InputPlumber 2>/dev/null |
		grep -E '^/org/shadowblip/InputPlumber/CompositeDevice[0-9]+$'); do
		busctl --system --timeout=2 set-property org.shadowblip.InputPlumber "$dev" \
			org.shadowblip.Input.CompositeDevice InterceptMode u 0 >/dev/null 2>&1 || true
	done
}

# X11 on purpose: gamescope reads focus and overlay properties from X windows.
# Not exec'd: when the app exits (or crashes) we still hand the controller back.
# Steam writes its settings back from memory when it exits, so Steam settings GameCove changed
# while Steam ran wait in GameCove's settings until Steam is stopped. They are written at the
# app's start (StoreManager.setup), which then leaves $XDG_RUNTIME_DIR/gamecove-steam-ready:
# Steam starts after that (or after GAMECOVE_STEAM_WAIT_S, or at once if the app dies).
READY="${XDG_RUNTIME_DIR:-/nonexistent}/gamecove-steam-ready"
rm -f "$READY" 2>/dev/null
HEARTBEAT=""
if [ -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then
	HEARTBEAT="$XDG_RUNTIME_DIR/gamecove-heartbeat"
	rm -f "$HEARTBEAT" 2>/dev/null
	export GAMECOVE_HEARTBEAT="$HEARTBEAT"
fi
# seconds since boot: a wall-clock step (NTP at boot, a time-zone fix) mustn't make a short
# run look healthy (review 2, low 19)
uptime_s() {
	u=0
	{ read -r u _ </proc/uptime; } 2>/dev/null || u=0
	echo "${u%%.*}"
}
started_at="$(uptime_s)"
"$GAMECOVE_BIN" --display-driver x11 --rendering-driver opengl3 --fullscreen "$@" &
app=$!
waited=0
if steam_running || [ ! -d "${XDG_RUNTIME_DIR:-/nonexistent}" ]; then
	start_steam
else
	waited=0
	limit=$(( ${GAMECOVE_STEAM_WAIT_S:-10} * 5 ))
	while [ ! -e "$READY" ] && [ "$waited" -lt "$limit" ] && kill -0 "$app" 2>/dev/null; do
		sleep 0.2
		waited=$((waited + 1))
	done
	start_steam
fi
stopping=0
trap 'stopping=1; kill -TERM "$app" 2>/dev/null' TERM INT HUP
# Watch the app once a second (counted from its start, the Steam wait included):
#  - not ready after READY_TIMEOUT_S: hung at start (ready = the first heartbeat, or
#    the ready file only when no heartbeat is expected);
#  - heartbeat unchanged for HEARTBEAT_STALE_S while it says "ui": hung (an app
#    without a heartbeat is only checked for readiness);
#  - ready and up HEALTHY_S with a live heartbeat (or none expected): clears the count.
up=$((waited / 5))
ready=0
beat=""
stale=0
hung=""
healthy=0
while kill -0 "$app" 2>/dev/null; do
	sleep 1
	up=$((up + 1))
	[ "$stopping" -eq 0 ] || continue
	if [ -n "$HEARTBEAT" ] && [ -f "$HEARTBEAT" ]; then
		ready=1
		now="$(head -n 1 "$HEARTBEAT" 2>/dev/null)" || now=""
		if [ "$now" != "$beat" ] || [ "${now#* }" = game ]; then
			beat="$now"
			stale=0
		else
			stale=$((stale + 1))
		fi
		if [ "$stale" -ge "$HEARTBEAT_STALE_S" ]; then
			hung="no heartbeat for ${stale}s"
		fi
	elif [ -z "$HEARTBEAT" ] && [ -e "$READY" ]; then
		# the ready file is written early (Library autoload): with a heartbeat expected,
		# only the first beat (end of main.gd's _ready) says the UI really came up (review 2, problem 4)
		ready=1
	fi
	if [ "$ready" -eq 0 ] && [ "$up" -ge "$READY_TIMEOUT_S" ]; then
		hung="not ready after ${up}s"
	fi
	if [ -n "$hung" ]; then
		log "GameCove is hung ($hung); stopping it"
		kill -KILL "$app" 2>/dev/null
		break
	fi
	if [ "$healthy" -eq 0 ] && [ "$ready" -eq 1 ] && [ "$up" -ge "$HEALTHY_S" ] && [ "$stale" -lt 10 ]; then
		healthy=1
		clear_crashes
	fi
done
code=0
wait "$app" || code=$?
# The loop can miss the healthy mark (a slow Steam start, a loaded machine), so
# judge the whole run by the clock too: a crash after a healthy run counts as 1.
ran=$(( $(uptime_s) - started_at ))
if [ -z "$hung" ] && [ "$ready" -eq 1 ] && [ "$ran" -ge "$HEALTHY_S" ] && [ "$stale" -lt 10 ]; then
	clear_crashes
fi
rm -f "$HEARTBEAT" 2>/dev/null
reset_input_intercept
if [ -n "$hung" ]; then
	record_crash hung
	[ "$code" -ne 0 ] || code=1
elif [ "$code" -eq 0 ]; then
	clear_crashes
elif [ "$stopping" -eq 0 ]; then
	record_crash
fi
exit "$code"
