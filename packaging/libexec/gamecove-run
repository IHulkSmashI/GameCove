#!/bin/bash
# gamecove-run - GameCove's per-game launch wrapper. Steam launch options:  /usr/libexec/gamecove/gamecove-run %command%
# (GameCove adds it when a per-game setting needs the game's environment; steam:// takes no environment.)
#
# Ported from ClawDeck's tools/clawdeck-launch.sh (same author), renamed to GameCove's folders:
#   - the per-game files GameCove wrote, both KEY=VALUE lines:
#       ~/.local/share/gamecove/launch/<appid>.perf.env  GameCove's app: MangoHud frame limiter, lsfg-vk profile,
#                                                        Launcher's upscaler/latency variables, the user's own
#       ~/.local/share/gamecove/launch/<appid>.env       the upscaling helper (OptiScaler, XeSS; launchenv.write)
#     the user's own WINEDLLOVERRIDES and DXVK_CONFIG are kept (ours are added, not instead)
#   - the XeSS XMX driver for this game only, set before Steam's container starts (ClawDeck's xmxscope findings)
#   - IGDEXT_XELL_LOG=1 and one launch per XeLL log, so GameCove can show what low latency did
#   - a launch log (<appid>.log) and when the game last started (<appid>.started)
# Left out from ClawDeck's wrapper: the MangoHud autotune log (GameCove reads mangoapp's), the E-cores switch
# (power controls), and the Decky Framegen second stage (GameCove puts its own OptiScaler in; a game set up by Decky
# Framegen still works: "gamecove-run ~/fgmod/fgmod %command%" exports first, then runs fgmod).
# Env: GAMECOVE_RUNTIME overrides the folder (tests).
set -u
RUNTIME="${GAMECOVE_RUNTIME:-$HOME/.local/share/gamecove}"
appid="${SteamAppId:-${SteamGameId:-0}}"
case "$appid" in *[!0-9]*|"") appid=0 ;; esac

say() { echo "gamecove: $*" >&2; [ -n "${GAMECOVE_LAUNCH_LOG:-}" ] && echo "gamecove: $*" >> "$GAMECOVE_LAUNCH_LOG" 2>/dev/null; return 0; }

# xmx_pkg: the folder of xess-xmx-linux's package (igdext64.dll, run/shim-stamp), from ANV_CM_KERNEL_DIR in xmx.env
# or GameCove's install folder (unpacked one level down)
xmx_pkg() {
  local d="${ANV_CM_KERNEL_DIR:-}"; d="${d%/kernels}"
  [ -n "$d" ] && [ -f "$d/igdext64.dll" ] && { echo "$d"; return; }
  for d in "$RUNTIME"/xess-xmx-linux-*/xess-xmx-linux-* "$RUNTIME"/xess-xmx-linux-*; do
    [ -f "$d/igdext64.dll" ] && { echo "$d"; return; }
  done
}

# load_env FILE: KEY=VALUE lines into the environment; comments and bad names skipped
load_env() {
  local k v
  [ -f "$1" ] || return 0
  while IFS='=' read -r k v; do
    [ -n "$k" ] && [ "${k#\#}" = "$k" ] || continue
    case "$k" in *[!A-Za-z0-9_]*|[0-9]*) continue ;; esac
    if [ "$k" = WINEDLLOVERRIDES ] && [ -n "${WINEDLLOVERRIDES:-}" ]; then v="$v;$WINEDLLOVERRIDES"; fi
    if [ "$k" = DXVK_CONFIG ] && [ -n "${DXVK_CONFIG:-}" ]; then v="$DXVK_CONFIG;$v"; fi
    export "$k=$v"
  done < "$1"
}

perffile="$RUNTIME/launch/$appid.perf.env"
envfile="$RUNTIME/launch/$appid.env"
export GAMECOVE_LAUNCH_LOG="$RUNTIME/launch/$appid.log"
if mkdir -p "$RUNTIME/launch" 2>/dev/null && : > "$GAMECOVE_LAUNCH_LOG" 2>/dev/null; then
  say "launch $(date '+%F %T'), appid $appid"
  p="${STEAM_COMPAT_TOOL_PATHS:-}"; say "proton ${p%%:*}"
  for a in "$@"; do case "$a" in *.exe|*.EXE) say "exe $a"; break;; esac; done
  for f in "$perffile" "$envfile"; do
    [ -f "$f" ] && say "settings $(basename "$f"): $(grep -v '^#' "$f" | tr '\n' ' ')"
  done
else
  GAMECOVE_LAUNCH_LOG=""
fi
mkdir -p "$RUNTIME/launch" 2>/dev/null && : > "$RUNTIME/launch/$appid.started" 2>/dev/null
load_env "$perffile"
load_env "$envfile"

# The XeSS XMX driver for this game, set HERE, before Steam's container starts: pressure-vessel builds the
# container's Vulkan driver list from this environment (ClawDeck: CONTROL on the Claw 8 EX, 2026-11-04).
xmxenv="$RUNTIME/xmx.env"
if [ -f "$xmxenv" ] && [ "${GAMECOVE_XMX:-}" != 0 ]; then
  want="${GAMECOVE_XMX:-}"
  [ -z "$want" ] && [ -f "$RUNTIME/xmx-every-game" ] && want=1
  if [ -z "$want" ] && [ -d "${STEAM_COMPAT_INSTALL_PATH:-/nonexistent}" ] && \
     [ -n "$(find "$STEAM_COMPAT_INSTALL_PATH" -maxdepth 5 \( -iname 'libxess*.dll' -o -iname 'libxell*.dll' -o -iname 'optiscaler.ini' \) -print -quit 2>/dev/null)" ]; then
    want=1
  fi
  if [ "$want" = 1 ]; then
    while IFS='=' read -r k v; do
      [ -n "$k" ] && [ "${k#\#}" = "$k" ] || continue
      export "$k=$v"
    done < "$xmxenv"
    say "XeSS XMX driver for this game (set before the container)"
    shimdir=$(xmx_pkg)
    if [ -n "$shimdir" ]; then
      pcopy=$(find "${STEAM_COMPAT_DATA_PATH:-/nonexistent}/pfx/drive_c/windows/system32" -ipath '*driverstore/filerepository/igd_faux.inf_1/igdext64.dll' -print -quit 2>/dev/null)
      if [ -n "$pcopy" ] && cmp -s "$pcopy" "$shimdir/igdext64.dll"; then
        say "XMX shim: this prefix has it"
      else
        real=$(cd "$shimdir" && pwd -P)
        export INTC_ALT_DRIVER_EXTENSIONS_PATH="Z:${real//\//\\}"
        say "XMX shim for any Proton: $INTC_ALT_DRIVER_EXTENSIONS_PATH"
      fi
      tp="${STEAM_COMPAT_TOOL_PATHS:-}"; tp="${tp%%:*}"
      bundled="$tp/files/lib/wine/igdext/x86_64-windows/igdext64.dll"
      if [ -n "$tp" ] && [ -f "$bundled" ] && ! cmp -s "$bundled" "$shimdir/igdext64.dll"; then
        if [ -w "$bundled" ] || chmod u+w "$bundled" 2>/dev/null; then
          if ! grep -aq 'IGDEXT_' "$bundled" && { [ ! -f "$bundled.stock" ] || ! cmp -s "$bundled" "$bundled.stock"; }; then
            chmod u+w "$bundled.stock" 2>/dev/null; cp -p "$bundled" "$bundled.stock"
          fi
          if cp -f "$shimdir/igdext64.dll" "$bundled"; then
            [ -f "$shimdir/run/shim-stamp" ] && touch -r "$shimdir/run/shim-stamp" "$bundled" 2>/dev/null
            say "XMX shim put into this Proton's own igdext64.dll ($tp; original kept as .stock)"
          fi
        else
          say "this Proton can't be changed ($bundled is read-only): no XMX there. Pick another Proton for this game"
        fi
      fi
    else
      say "XMX shim: no igdext64.dll in the XeSS XMX package; the prefix's copy is used"
    fi
  else
    say "XMX driver not used: nothing in this game asks for it"
  fi
fi
if [ -z "${IGDEXT_XELL_LOG:-}" ] && [ -f "$xmxenv" ]; then export IGDEXT_XELL_LOG=1; fi
if [ -n "${IGDEXT_XELL_LOG:-}" ] && [ -d "${STEAM_COMPAT_DATA_PATH:-/nonexistent}/pfx/drive_c" ]; then
  for f in igdext_trace.log igdext_xell.log; do
    [ -f "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f" ] && mv -f "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f" "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f.prev"
  done
fi
[ $# -gt 0 ] || { say "nothing to run (launch options need %command%)"; exit 64; }
exec "$@"
