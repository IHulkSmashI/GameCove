#!/bin/bash
# gamecove-run - GameCove's per-game launch wrapper. Steam launch options (a fall-through form, so the game starts
# without GameCove):  /bin/sh -c '[ -x /usr/libexec/gamecove/gamecove-run ] && exec ... "$@"; exec "$@"' gamecove-run %command%
# (GameCove adds it when a per-game setting needs the game's environment; steam:// takes no environment.)
#
# Ported from ClawDeck's tools/clawdeck-launch.sh (same author), renamed to GameCove's folders:
#   - the per-game files GameCove wrote, both KEY=VALUE lines:
#       ~/.local/share/gamecove/launch/<appid>.perf.env  GameCove's app: MangoHud frame limiter, lsfg-vk profile,
#                                                        Launcher's upscaler/latency variables, the user's own
#       ~/.local/share/gamecove/launch/<appid>.env       the upscaling helper (OptiScaler, XeSS; launchenv.write)
#     the user's own WINEDLLOVERRIDES and DXVK_CONFIG are kept (ours are added, not instead)
#   - the XeSS XMX driver for this game only, set before Steam's container starts (ClawDeck's xmxscope findings),
#     and its igdext64.dll shim for whatever Proton the game runs on, exactly as ClawDeck's wrapper does it (below)
#   - IGDEXT_XELL_LOG=1 and one launch per XeLL log, so GameCove can show what low latency did
#   - a launch log (<appid>.log) and when the game last started (<appid>.started)
#   - Decky Framegen's fgmod next in the command: GameCove's second stage runs after it, so FSR 4 on XMX
#     (GAMECOVE_FSR4_XMX) goes over fgmod's FSR 4 and is taken out again when it is switched off
# Left out from ClawDeck's wrapper: the MangoHud autotune log (GameCove reads mangoapp's) and the E-cores switch
# (power controls).
# Env: GAMECOVE_RUNTIME overrides the folder (tests); GAMECOVE_CABINET, GAMECOVE_FSR4_XMX_DIR override where the
# second stage takes the LZMS cabinet.dll and nitec's files from.
set -u
RUNTIME="${GAMECOVE_RUNTIME:-$HOME/.local/share/gamecove}"
appid="${SteamAppId:-${SteamGameId:-0}}"
case "$appid" in *[!0-9]*|"") appid=0 ;; esac

say() { echo "gamecove: $*" >&2; [ -n "${GAMECOVE_LAUNCH_LOG:-}" ] && echo "gamecove: $*" >> "$GAMECOVE_LAUNCH_LOG" 2>/dev/null; return 0; }

# xmx_pkg: the folder of xess-xmx-linux's package (igdext64.dll, run/shim-stamp), from ANV_CM_KERNEL_DIR in xmx.env
# or GameCove's install folder (unpacked one level down)
xmx_pkg() {
  local d="${ANV_CM_KERNEL_DIR:-}"; d="${d%/kernels}"
  [ -n "$d" ] && [ -f "$d/igdext64.dll" ] && { echo "$d"; return; }
  for d in "$RUNTIME"/xess-xmx-linux-*/xess-xmx-linux-* "$RUNTIME"/xess-xmx-linux-*; do
    [ -f "$d/igdext64.dll" ] && { echo "$d"; return; }
  done
}

# Earlier GameCove builds kept the shim only in the game's prefix (stock copy next to it as
# igdext64.dll.gamecove-stock, or a .gamecove-added marker). That is not what ClawDeck does and it lost against
# Protons that copy their own igdext64.dll over the prefix at every launch; put such a prefix back as it was.
prefix_cleanup() {
  local sys32="${STEAM_COMPAT_DATA_PATH:-/nonexistent}/pfx/drive_c/windows/system32" d
  [ -d "$sys32" ] || return 0
  d=$(find "$sys32" -maxdepth 3 -type d -ipath '*driverstore/filerepository/igd_faux.inf_1' -print -quit 2>/dev/null)
  [ -n "$d" ] || return 0
  if [ -f "$d/igdext64.dll.gamecove-stock" ]; then
    mv -f "$d/igdext64.dll.gamecove-stock" "$d/igdext64.dll" && say "this game's prefix has its own igdext64.dll back (from an older GameCove)"
  elif [ -f "$d/igdext64.dll.gamecove-added" ]; then
    rm -f "${d:?}/igdext64.dll" "${d:?}/igdext64.dll.gamecove-added"
  fi
}

# own_cabinet: GameCove's LZMS cabinet.dll (tools/cabinet-lzms), where optiscaler.own_cabinet() looks
own_cabinet() {
  local here c
  here=$(cd "$(dirname "$0")" && pwd -P)
  for c in "${GAMECOVE_CABINET:-}" "${here%/libexec/gamecove}/lib/gamecove/bin/cabinet.dll" /usr/lib/gamecove/bin/cabinet.dll \
           "$here/../../tools/cabinet-lzms/out/cabinet.dll" "$RUNTIME/cabinet.dll" "$HOME/homebrew/plugins/ClawDeck/bin/cabinet.dll"; do
    [ -n "$c" ] && [ -f "$c" ] && { echo "$c"; return; }
  done
  echo "${GAMECOVE_CABINET:-/usr/lib/gamecove/bin/cabinet.dll}"
}

# ---- second stage: Decky Framegen's fgmod has copied OptiScaler and its FSR 4 into the game, then started us -----
# FSR 4.1.2 on XMX (OptiScaler upscaler "FSR 4 XMX"): nitec's files from ~/fsr4-xmx go over fgmod's FSR 4, with
# GameCove's own LZMS cabinet.dll and Wine's own cabinet.dll as cabinet_wine.dll next to it. What GameCove added is
# listed in .gamecove-fsr4xmx so the next launch without FSR 4 XMX removes it again (fgmod puts its own FSR 4 back
# every launch). ClawDeck's second stage, line for line.
if [ "${GAMECOVE_STAGE:-}" = post ]; then
  unset GAMECOVE_STAGE
  dir=""
  for a in "$@"; do case "$a" in *.exe|*.EXE) dir=$(dirname "$a"); break;; esac; done
  [ -z "$dir" ] && dir="${STEAM_COMPAT_INSTALL_PATH:-}"
  if [ -n "$dir" ] && [ -d "$dir" ]; then
    ue=$(find "$dir" -maxdepth 4 \( -iname '*-Win64-Shipping.exe' -o -iname '*-WinGDK-Shipping.exe' \) 2>/dev/null | head -1)
    [ -n "$ue" ] && dir=$(dirname "$ue")
    list="$dir/.gamecove-fsr4xmx"
    if [ -f "$list" ] && [ -z "${GAMECOVE_FSR4_XMX:-}" ]; then
      while read -r f; do
        case "$f" in ""|*/*|.*) continue ;; esac      # names only, never a path out of the game's folder
        rm -f "${dir:?}/${f:?}"
      done < "$list"
      rm -f "${list:?}"
      say "FSR 4 XMX files removed from $dir"
    fi
    src="${GAMECOVE_FSR4_XMX_DIR:-$HOME/fsr4-xmx}"
    cab=$(own_cabinet)
    if [ -n "${GAMECOVE_FSR4_XMX:-}" ]; then
      if [ -f "$src/amd_fidelityfx_upscaler_dx12.dll" ] && [ -f "$src/fsr-original.dll" ] && [ -f "$cab" ]; then
        : > "$list"
        cp -f "$src/amd_fidelityfx_upscaler_dx12.dll" "$dir/"     # fgmod's own FSR 4 is put back by fgmod each launch
        cp -f "$src/fsr-original.dll" "$dir/" && echo fsr-original.dll >> "$list"
        cp -f "$cab" "$dir/cabinet.dll" && echo cabinet.dll >> "$list"
        wcab="$src/cabinet_wine.dll"
        if [ ! -f "$wcab" ]; then                                 # Wine's own cabinet, from the Proton running this game
          tp="${STEAM_COMPAT_TOOL_PATHS:-}"
          IFS=: read -r -a tps <<< "$tp"
          for p in "${tps[@]}"; do
            [ -f "$p/files/lib/wine/x86_64-windows/cabinet.dll" ] && { wcab="$p/files/lib/wine/x86_64-windows/cabinet.dll"; break; }
          done
        fi
        [ -f "$wcab" ] && cp -f "$wcab" "$dir/cabinet_wine.dll" && echo cabinet_wine.dll >> "$list"
        ig=$(xmx_pkg); [ -n "$ig" ] && ig="$ig/igdext64.dll"
        [ -f "$src/igdext64.dll" ] && ig="$src/igdext64.dll"
        if [ -n "$ig" ] && [ ! -f "$dir/igdext64.dll" ]; then cp -f "$ig" "$dir/" && echo igdext64.dll >> "$list"; fi
        say "FSR 4 XMX ($GAMECOVE_FSR4_XMX) into $dir"
      else
        say "FSR 4 XMX: needs amd_fidelityfx_upscaler_dx12.dll and fsr-original.dll in $src, and GameCove's $cab; fgmod's FSR 4 stays"
      fi
    fi
  fi
  [ $# -gt 0 ] || exit 64
  exec "$@"
fi

# load_env FILE: KEY=VALUE lines into the environment; comments and bad names skipped
load_env() {
  local k v
  [ -f "$1" ] || return 0
  while IFS='=' read -r k v; do
    [ -n "$k" ] && [ "${k#\#}" = "$k" ] || continue
    case "$k" in *[!A-Za-z0-9_]*|[0-9]*) continue ;; esac
    if [ "$k" = WINEDLLOVERRIDES ] && [ -n "${WINEDLLOVERRIDES:-}" ]; then v="$v;$WINEDLLOVERRIDES"; fi
    if [ "$k" = DXVK_CONFIG ] && [ -n "${DXVK_CONFIG:-}" ]; then v="$DXVK_CONFIG;$v"; fi
    export "$k=$v"
  done < "$1"
}

perffile="$RUNTIME/launch/$appid.perf.env"
envfile="$RUNTIME/launch/$appid.env"
export GAMECOVE_LAUNCH_LOG="$RUNTIME/launch/$appid.log"
if mkdir -p "$RUNTIME/launch" 2>/dev/null && : > "$GAMECOVE_LAUNCH_LOG" 2>/dev/null; then
  say "launch $(date '+%F %T'), appid $appid"
  p="${STEAM_COMPAT_TOOL_PATHS:-}"; say "proton ${p%%:*}"
  for a in "$@"; do case "$a" in *.exe|*.EXE) say "exe $a"; break;; esac; done
  for f in "$perffile" "$envfile"; do
    [ -f "$f" ] && say "settings $(basename "$f"): $(grep -v '^#' "$f" | tr '\n' ' ')"
  done
else
  GAMECOVE_LAUNCH_LOG=""
fi
mkdir -p "$RUNTIME/launch" 2>/dev/null && : > "$RUNTIME/launch/$appid.started" 2>/dev/null
load_env "$perffile"
load_env "$envfile"

prefix_cleanup

# The XeSS XMX driver for this game, set HERE, before Steam's container starts: pressure-vessel builds the
# container's Vulkan driver list (VK_DRIVER_FILES) from this environment, and Proton's user_settings (the scope
# script) can't change a variable that is already set. Set only there, the game kept the stock driver: no XMX for
# XeSS, XeSS-FG or FSR 4.1.2 (ClawDeck: CONTROL on the Claw 8 EX, 2026-11-04).
xmxenv="$RUNTIME/xmx.env"
if [ -f "$xmxenv" ] && [ "${GAMECOVE_XMX:-}" != 0 ]; then
  want="${GAMECOVE_XMX:-}"
  [ -z "$want" ] && [ -f "$RUNTIME/xmx-every-game" ] && want=1
  if [ -z "$want" ] && [ -d "${STEAM_COMPAT_INSTALL_PATH:-/nonexistent}" ] && \
     [ -n "$(find "$STEAM_COMPAT_INSTALL_PATH" -maxdepth 5 \( -iname 'libxess*.dll' -o -iname 'libxell*.dll' -o -iname 'optiscaler.ini' \) -print -quit 2>/dev/null)" ]; then
    want=1
  fi
  if [ "$want" = 1 ]; then
    while IFS='=' read -r k v; do
      [ -n "$k" ] && [ "${k#\#}" = "$k" ] || continue
      export "$k=$v"
    done < "$xmxenv"
    say "XeSS XMX driver for this game (set before the container)"
    # The shim straight from the package, through Wine's Z: drive (the real Linux folder), for every Proton.
    # XeSS, XeSS-FG and FSR 4.1.2 look in INTC_ALT_DRIVER_EXTENSIONS_PATH first; the session file points it at the
    # prefix's driver store, and that copy depends on the Proton: Protons that bundle Intel's igdext64.dll (Proton
    # Experimental, GE-Proton, proton-cachyos) copy theirs over it at each launch, Proton 11.0 has no driver store at
    # all, and a new prefix has nothing yet. Then the game ran on the stock path: no XMX, a black screen with FSR 4.1.2
    # (ClawDeck: FH5 on a Claw 8 AI+, 2026-11-07). A folder outside the prefix is the same for every Proton and prefix.
    shimdir=$(xmx_pkg)
    if [ -n "$shimdir" ]; then
      # the prefix's copy when it is the shim (the path proven on Proton 11.0), else the package folder
      pcopy=$(find "${STEAM_COMPAT_DATA_PATH:-/nonexistent}/pfx/drive_c/windows/system32" -maxdepth 4 -ipath '*/driverstore/filerepository/igd_faux.inf_1/igdext64.dll' -print -quit 2>/dev/null)
      if [ -n "$pcopy" ] && cmp -s "$pcopy" "$shimdir/igdext64.dll"; then
        say "XMX shim: this prefix has it"
      else
        real=$(cd "$shimdir" && pwd -P)
        export INTC_ALT_DRIVER_EXTENSIONS_PATH="Z:${real//\//\\}"
        say "XMX shim for any Proton: $INTC_ALT_DRIVER_EXTENSIONS_PATH (no shim in this prefix's driver store)"
      fi
      # GE-Proton overrides that path (C:\Windows\System32) and, like Proton Experimental and proton-cachyos, copies
      # its own bundled igdext64.dll into the prefix at every launch. So the Proton this game runs on gets the shim as
      # its bundled copy, the way xess-xmx-linux's install.sh does it for every Proton it finds (original kept as
      # .stock, its uninstall.sh puts it back; stamped like install.sh's copies, so its watcher leaves it alone).
      # Here at launch it also covers a Proton added since the driver was installed. Undo: uninstalling XeSS on XMX
      # puts every .stock back (xess.restore_igdext). A Proton only root can write (a distribution package) can't
      # be changed: said in the launch log, and the XMX check on the game's page shows the result.
      tp="${STEAM_COMPAT_TOOL_PATHS:-}"; tp="${tp%%:*}"
      bundled="$tp/files/lib/wine/igdext/x86_64-windows/igdext64.dll"
      if [ -n "$tp" ] && [ -f "$bundled" ] && ! cmp -s "$bundled" "$shimdir/igdext64.dll"; then
        if [ -w "$bundled" ] || chmod u+w "$bundled" 2>/dev/null; then
          if ! grep -aq 'IGDEXT_' "$bundled" && { [ ! -f "$bundled.stock" ] || ! cmp -s "$bundled" "$bundled.stock"; }; then
            chmod u+w "$bundled.stock" 2>/dev/null; cp -p "$bundled" "$bundled.stock"
          fi
          if cp -f "$shimdir/igdext64.dll" "$bundled"; then
            [ -f "$shimdir/run/shim-stamp" ] && touch -r "$shimdir/run/shim-stamp" "$bundled" 2>/dev/null
            say "XMX shim put into this Proton's own igdext64.dll ($tp; original kept as .stock)"
          fi
        else
          say "this Proton can't be changed ($bundled is read-only): it puts Intel's stock igdext64.dll into the game, so no XMX there. Pick another Proton for this game"
        fi
      elif [ -f "$bundled" ]; then
        say "this Proton's own igdext64.dll is already the XMX shim"
      fi
    else
      say "XMX shim: no igdext64.dll in the XeSS XMX package; the prefix's copy is used"
    fi
  else
    say "XMX driver not used: nothing in this game asks for it (no GAMECOVE_XMX=1, no XeSS or OptiScaler found)"
  fi
elif [ ! -f "$xmxenv" ]; then
  say "XMX driver not used: $xmxenv is missing (the XeSS XMX driver isn't installed)"
else
  say "XMX driver not used: XMX is off for this game"
fi
if [ -z "${IGDEXT_XELL_LOG:-}" ] && [ -f "$xmxenv" ]; then export IGDEXT_XELL_LOG=1; fi
if [ -n "${IGDEXT_XELL_LOG:-}" ] && [ -d "${STEAM_COMPAT_DATA_PATH:-/nonexistent}/pfx/drive_c" ]; then
  for f in igdext_trace.log igdext_xell.log; do
    [ -f "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f" ] && mv -f "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f" "$STEAM_COMPAT_DATA_PATH/pfx/drive_c/$f.prev"
  done
fi
[ $# -gt 0 ] || { say "nothing to run (launch options need %command%)"; exit 64; }
# Decky Framegen's fgmod next: run it with GameCove's second stage in front of the game, so files GameCove adds
# (FSR 4 XMX) go in after fgmod's own and anything left from an earlier launch is cleaned up
if [ $# -ge 2 ] && [ "$(basename "$1")" = fgmod ]; then
  fg="$1"; shift
  export GAMECOVE_STAGE=post
  exec "$fg" "$0" "$@"
fi
exec "$@"
