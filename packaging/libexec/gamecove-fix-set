#!/bin/sh
# gamecove-fix-set: the no-password entry point to GameCove's root helper.
#
#   pkexec /usr/libexec/gamecove/gamecove-fix-set <name> set <value>
#   pkexec /usr/libexec/gamecove/gamecove-fix-set <name> status
#
# polkit lets the person at the handheld (active local session only: allow_active
# yes, allow_inactive / allow_any no) run THIS file without a password
# (action io.github.ihulksmashi.gamecove.fix-set), because the gamescope session
# has no polkit agent to ask for one. So it is the day-to-day settings only, each
# value checked here and again by the fix (docs/SYSTEM.md, "GameCove's root
# actions", says why each one is here or not):
#
#   charge-limit  set <50-100>                   battery charge limit (sysfs)
#   charge-limit  set release                    let it charge now, keep the limit
#                                                (GameCove's session runs it on exit)
#   fan           set auto|quiet|max             fan preset (sysfs)
#   fan           set curve:<d1>,<d2>,...        your own fan curve (table drivers; fix.sh checks
#                                                it is never quieter than Quiet and never falls)
#   power-tune    set <key>:<value> | restore    keys: boost, epp, governor, cpumax, gpulevel,
#                                                gpumin, gpumax, gpuprofile, sppt, fppt, platform,
#                                                tau, battery, thermald; fix.sh checks every value
#                                                against what the kernel offers. thermald:hold is
#                                                bounded: it lasts while a game runs (60 s to start)
#                                                and thermald starts again by itself after
#   claw8ex-gyro  set accel-on|accel-off         accelerometer in the InputPlumber override
#                                                (the gyro fix must already be installed)
#   claw8ex-gyro | claw8ex-buttons  set refresh  rebuild GameCove's InputPlumber override from the
#                                                current stock file after an OS update (or drop it
#                                                if the new layout can't be edited); nothing else
#   controller-led set off | <zone>,<rrggbb>,<percent>[,<effect>[,<speed>]]
#                                                handheld RGB lights (kernel LED class);
#                                                fix.sh checks every field strictly
#   <the fixes above> status                     read-only
#
# Not here (administrator password, auth_admin_keep, through gamecove-fix): every install
# and remove, the small file fixes (udev rules and session files), power-tune smt, cores,
# sleep and mcu, and every fix that touches boot configuration, firmware or systemd units.
#
# After checking, it hands over to gamecove-fix (same validation, logging and
# exit codes). Exit 64 bad usage, 65 fix not allowed here, 66 value not allowed.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ -n "${PKEXEC_UID:-}" ]; then
	DISPATCHER=/usr/libexec/gamecove/gamecove-fix
else
	# Tests: the dispatcher next to this file.
	DISPATCHER="$(cd "$(dirname "$0")" && pwd)/gamecove-fix"
fi

usage() {
	echo "usage: gamecove-fix-set charge-limit|fan|claw8ex-gyro|claw8ex-buttons|controller-led|power-tune set <value>" >&2
	echo "       gamecove-fix-set <name> status" >&2
	echo "install and remove need an administrator: pkexec /usr/libexec/gamecove/gamecove-fix" >&2
	exit 64
}

die() {
	echo "gamecove-fix-set: $1" >&2
	exit "$2"
}

[ $# -ge 2 ] || usage
name="$1"
action="$2"

case "$name" in
charge-limit | fan | claw8ex-gyro | claw8ex-buttons | controller-led | power-tune) ;;
*) die "fix '$name' can't be changed without a password; use gamecove-fix" 65 ;;
esac

case "$action" in
status)
	[ $# -eq 2 ] || usage
	exec sh "$DISPATCHER" "$name" status
	;;
set)
	[ $# -eq 3 ] || usage
	;;
*)
	die "only set and status here; install and remove need gamecove-fix (administrator password)" 64
	;;
esac

value="$3"
case "$name:$value" in
charge-limit:[5-9][0-9] | charge-limit:100 | charge-limit:release) ;;
fan:auto | fan:quiet | fan:max) ;;
fan:curve:*)
	case "${value#curve:}" in
	"" | *[!0-9,]* | ,* | *, | *,,*) die "value not allowed for $name" 66 ;;
	esac
	[ "${#value}" -le 64 ] || die "value not allowed for $name" 66
	;;
power-tune:restore) ;;
power-tune:boost:* | power-tune:epp:* | power-tune:governor:* | \
	power-tune:cpumax:* | power-tune:gpulevel:* | power-tune:gpumin:* | power-tune:gpumax:* | \
	power-tune:gpuprofile:* | power-tune:sppt:* | power-tune:fppt:* | power-tune:platform:* | \
	power-tune:tau:* | power-tune:thermald:* | power-tune:battery:*)
	case "${value#*:}" in
	"" | *[!a-z0-9_-]*) die "value not allowed for $name" 66 ;;
	esac
	[ "${#value}" -le 48 ] || die "value not allowed for $name" 66
	;;
claw8ex-gyro:accel-on | claw8ex-gyro:accel-off) ;;
claw8ex-gyro:refresh | claw8ex-buttons:refresh) ;;
controller-led:off) ;;
controller-led:*[!a-z0-9,]*) die "value not allowed for $name" 66 ;;
controller-led:all,[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f],[0-9]* | controller-led:[0-9],[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f],[0-9]*) ;;
*) die "value not allowed for $name" 66 ;;
esac

exec sh "$DISPATCHER" "$name" set "$value"
